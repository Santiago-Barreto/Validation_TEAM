# Persistencia de comentarios — aislada de Validation.
# Por defecto el backend usa JSON local (backend/data/comentarios_team.json).
# PUNTOS_BACKEND=json
#
# Si quieres Sheets, crea una hoja NUEVA solo para TEAM (nunca la de Validation):
# PUNTOS_BACKEND=sheets
# GOOGLE_SHEET_ID=id_de_hoja_propia_team
#
# DATABASE_URL=
# GOOGLE_CREDENTIALS=
#
# SQLite LOCAL de estadísticas (copia en Validation_TEAM/data/mapbiomas.db):
# STATISTICS_DB_PATH=D:\GAIA2026_desarrollo\Validation_TEAM\data\mapbiomas.db
#
# Excel de avance Col4 (intérprete col. A × regionId col. B):
# AVANCE_COLOMBIA_XLSX=D:\GAIA2026_desarrollo\Validation_TEAM\COLOMBIA_COL_4_Formatos de avance detallado Colombia.xlsx
# AVANCE_SHEET=MAPA GENERAL COLOMBIA
